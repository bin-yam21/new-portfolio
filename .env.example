# Contact form (src/app/api/send/route.ts).
# Without RESEND_API_KEY / RESEND_TO_EMAIL the form returns 503 and logs a
# clear message; the build still succeeds.
# Get a key at https://resend.com/api-keys
RESEND_API_KEY=

# Where contact-form submissions are delivered.
RESEND_TO_EMAIL=

# Sender address. Optional — defaults to Resend's sandbox sender
# (onboarding@resend.dev), which ONLY delivers to the account that owns the
# API key. For real delivery, verify a domain in Resend and set this to an
# address on it, e.g. hello@yourdomain.com.
RESEND_FROM_EMAIL=
